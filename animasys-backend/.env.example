# Local overrides — copy values into your IDE run config / OS env.
# Do not commit real secrets into application.yml.

# --- Database ---------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/animasys_erp?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password

# true = use persistent H2 file ./.data/animasys_erp when MySQL is unavailable.
# Local/desktop fallback only — leave false (the default) in any shared deployment.
ALLOW_H2_FALLBACK=true
# Optional override (default is file-based under animasys-backend/.data/)
# H2_FALLBACK_JDBC_URL=jdbc:h2:file:./.data/animasys_erp;MODE=MySQL;AUTO_SERVER=TRUE;DATABASE_TO_UPPER=false

# --- Auth / security ---------------------------------------------------------
# Required, >=32 chars, unique per deployment. App refuses to start otherwise
# (see JwtTokenProvider.validateSecretOrFail). Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-32plus-char-secret
# Swagger UI / OpenAPI docs are protected by default; only expose them locally.
APP_SECURITY_PUBLIC_SWAGGER=false
# Only set true if a trusted reverse proxy sits in front of this app and sets
# X-Forwarded-For itself. Leaving this true with no proxy lets a caller spoof
# their IP and bypass login rate limiting.
APP_SECURITY_TRUST_PROXY_HEADERS=false
# Comma-separated CORS origins for the API, e.g. http://localhost:5173,https://app.example.com
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Seeding / migrations ----------------------------------------------------
# Optional demo catalog/services on startup. Core login accounts are always
# created when the employees table is empty, regardless of this flag.
SEED_DEMO_DATA=false
# Desktop installer sets this true once to repair PIN hashes that drifted
# from the login UI on already-shipped installs. Leave false otherwise.
SYNC_DEFAULT_PINS=false
# Auto-repair Flyway schema history on checksum mismatch (desktop installs
# legitimately edit already-applied migration scripts across upgrades). Set
# false for shared/server deployments where schema history should never be
# silently rewritten — a mismatch will then fail startup instead.
MIGRATION_AUTO_REPAIR=true

# --- AI assistant -------------------------------------------------------------
GEMINI_API_KEY=
# Development only — never enable in production (app.ai.mock-enabled; the
# production profile hard-forbids this at startup regardless of this value).
AI_MOCK_ENABLED=false
AI_REQUEST_TIMEOUT_MS=60000

# --- Logging (production profile only) ---------------------------------------
# Path for the rolling JSON log file written alongside JSON console output.
# LOG_FILE=./logs/animasys-backend.log
